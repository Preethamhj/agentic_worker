{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerificationResult",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "step_id": { "type": "string" },
    "status": { "type": "string", "enum": ["VERIFIED", "FAILED", "ESCALATE", "PARTIAL"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "integer" },
          "name": { "type": "string" },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        },
        "required": ["stage", "name", "passed", "detail"],
        "additionalProperties": false
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "Evidence.schema.json" } },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "duration_ms": { "type": "number" }
  },
  "required": ["schema_version", "step_id", "status", "stages", "evidence", "side_effects", "reasons", "duration_ms"],
  "additionalProperties": false
}
