{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionReceipt",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "step_id": { "type": "string" },
    "auth_id": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "exit_code": { "type": "integer" },
    "reported_success": { "type": "boolean" },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" }
  },
  "required": ["schema_version", "step_id", "auth_id", "started_at", "completed_at", "exit_code", "reported_success", "stdout", "stderr"],
  "additionalProperties": false
}
