{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanResponse",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "trace_id": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "clarify", "unsupported", "error"] },
    "intent": { "$ref": "Intent.schema.json" },
    "steps": { "type": "array", "items": { "$ref": "PlanStep.schema.json" } },
    "message": { "type": "string" }
  },
  "required": ["schema_version", "trace_id", "status", "intent", "steps", "message"],
  "additionalProperties": false
}
