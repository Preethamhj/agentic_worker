{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportRequest",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string" },
    "task_id": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": { "type": "string" },
          "status": { "type": "string" },
          "verification_status": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["step_id", "status", "verification_status", "summary"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "session_id", "task_id", "steps"],
  "additionalProperties": false
}
