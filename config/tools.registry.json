{
  "schema_version": 1,
  "tools": [
    {
      "tool_id": "fs.search_files",
      "version": "1.0",
      "risk": "low",
      "enabled": true,
      "description": "Enumerate files in allowed roots matching a pattern",
      "args_schema": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "root_path": { "type": "string" }
        },
        "required": ["pattern"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": [
          { "type": "dir_exists", "params": { "path_arg": "root_path" } }
        ]
      }
    },
    {
      "tool_id": "fs.create_folder",
      "version": "1.0",
      "risk": "medium",
      "enabled": true,
      "description": "Create a directory inside allowed roots",
      "args_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": [
          { "type": "dir_exists", "params": { "path_arg": "path" } }
        ]
      }
    },
    {
      "tool_id": "fs.create_file",
      "version": "1.0",
      "risk": "medium",
      "enabled": true,
      "description": "Write a text file inside allowed roots",
      "args_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": [
          { "type": "file_exists", "params": { "path_arg": "path" } }
        ]
      }
    },
    {
      "tool_id": "app.launch",
      "version": "1.0",
      "risk": "medium",
      "enabled": true,
      "description": "Launch an application from the allowlist",
      "args_schema": {
        "type": "object",
        "properties": {
          "app_id": { "type": "string" }
        },
        "required": ["app_id"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": [
          { "type": "process_running", "params": { "app_id_arg": "app_id" } }
        ]
      }
    },
    {
      "tool_id": "task.schedule_reminder",
      "version": "1.0",
      "risk": "medium",
      "enabled": true,
      "description": "Schedule a Task Scheduler reminder toast",
      "args_schema": {
        "type": "object",
        "properties": {
          "task_name": { "type": "string", "minLength": 1, "maxLength": 63 },
          "time_iso": { "type": "string", "format": "date-time" },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          }
        },
        "required": ["time_iso", "message"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": [
          { "type": "task_exists", "params": { "name_arg": "task_name" } }
        ]
      }
    },
    {
      "tool_id": "browser.open_link",
      "version": "1.0",
      "risk": "medium",
      "enabled": true,
      "description": "Open one visible HTTP or HTTPS link selected from the approved current-page snapshot in a new tab",
      "args_schema": {
        "type": "object",
        "properties": {
          "link_id": { "type": "string", "pattern": "^l[0-9a-f]{12}$" },
          "observation_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
          "tab_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "target_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "target_host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^\\s\\u0000-\\u001F\\u007F]+$" },
          "mode": { "type": "string", "const": "new_tab" }
        },
        "required": ["link_id", "observation_id", "tab_id", "target_hash", "target_host", "mode"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": []
      }
    },
    {
      "tool_id": "browser.search",
      "version": "1.0",
      "risk": "medium",
      "enabled": true,
      "description": "Type a search query into the selected browser page's search field and submit it (Jarvis browser chat only)",
      "args_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": []
      }
    },
    {
      "tool_id": "shell.run_powershell",
      "version": "1.0",
      "risk": "high",
      "enabled": false,
      "description": "Execute a PowerShell script",
      "args_schema": {
        "type": "object",
        "properties": {
          "script": { "type": "string" }
        },
        "required": ["script"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": []
      }
    },
    {
      "tool_id": "registry.set_value",
      "version": "1.0",
      "risk": "high",
      "enabled": false,
      "description": "Set an HKCU registry value",
      "args_schema": {
        "type": "object",
        "properties": {
          "key_path": { "type": "string" },
          "value_name": { "type": "string" },
          "value_data": { "type": "string" }
        },
        "required": ["key_path", "value_name", "value_data"],
        "additionalProperties": false
      },
      "verification_template": {
        "checks": []
      }
    }
  ]
}
