<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jarvis.Eval</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tests\Jarvis.TestSupport\Jarvis.TestSupport.csproj" />
    <ProjectReference Include="..\Jarvis.TestApp\Jarvis.TestApp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Jarvis.Contracts\Jarvis.Contracts.csproj" />
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
    <ProjectReference Include="..\Jarvis.Cli\Jarvis.Cli.csproj" />
    <ProjectReference Include="..\Jarvis.Safety\Jarvis.Safety.csproj" />
    <ProjectReference Include="..\Jarvis.Tools\Jarvis.Tools.csproj" />
    <ProjectReference Include="..\Jarvis.Verification\Jarvis.Verification.csproj" />
    <ProjectReference Include="..\Jarvis.Infrastructure\Jarvis.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="CopyTestApp" AfterTargets="Build">
    <ItemGroup>
      <TestAppOutput Include="..\Jarvis.TestApp\bin\$(Configuration)\net10.0-windows\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestAppOutput)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
