<UserControl x:Class="Jarvis.UI.BrowserWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="BrowserWorkspace_Loaded"
             Unloaded="BrowserWorkspace_Unloaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Back" Width="54" Height="30"
                        Margin="0,0,4,0" Click="Back_Click" IsEnabled="False" />
                <Button x:Name="ForwardButton" Content="Forward" Width="62" Height="30"
                        Margin="0,0,4,0" Click="Forward_Click" IsEnabled="False" />
                <Button Content="Refresh" Width="66" Height="30" Margin="0,0,4,0"
                        Click="Refresh_Click" />
                <Button Content="New tab" Width="68" Height="30" Margin="0,0,4,0"
                        Click="NewTab_Click" />
                <Button Content="Close tab" Width="72" Height="30"
                        Click="CloseTab_Click" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Go" Width="54" Height="30"
                    Margin="6,0,0,0" Click="Navigate_Click" />
            <TextBox x:Name="AddressInput" MinHeight="30" VerticalContentAlignment="Center"
                     Margin="6,0,0,0" ToolTip="Enter an HTTP or HTTPS website address."
                     KeyDown="AddressInput_KeyDown" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,6"
                   Text="Browser pages use a dedicated Jarvis profile. Downloads and site permissions are disabled in this phase."
                   TextWrapping="Wrap" Foreground="DimGray" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TabControl x:Name="BrowserTabs"
                        SelectionChanged="BrowserTabs_SelectionChanged" />
            <Border Grid.Column="1" Width="340" Margin="8,0,0,0"
                    Padding="8" BorderBrush="LightGray" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Browser chat" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,6" TextWrapping="Wrap" Foreground="DimGray"
                               Text="Search the open website or ask to open a visible link. Before planning, review and approve the exact page text and temporary link IDs/labels sent to local Ollama; URLs and form values are excluded. Opening a link requires separate approval. Form filling and booking are unsupported." />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="ChatCancelButton" DockPanel.Dock="Right" Content="Cancel" Padding="10,4"
                                Margin="6,0,0,0" Click="ChatCancel_Click" IsEnabled="False" />
                        <Button x:Name="ChatSendButton" DockPanel.Dock="Right" Content="Send" Padding="10,4"
                                Margin="6,0,0,0" Click="ChatSend_Click" />
                        <TextBox x:Name="ChatInput" MinHeight="30" VerticalContentAlignment="Center"
                                 KeyDown="ChatInput_KeyDown" />
                    </DockPanel>
                    <TextBox x:Name="ChatTranscript" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
