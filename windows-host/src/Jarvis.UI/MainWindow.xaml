<Window x:Class="Jarvis.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Height="720" Width="1080" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Run task" Width="110" Height="36" Margin="10,0,0,0"
                    Click="RunTask_Click" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />
            <Button Content="Cancel" Width="80" Height="36" Margin="10,0,0,0"
                    Click="CancelTask_Click" IsEnabled="{Binding IsRunning}" />
            <TextBox x:Name="PromptInput" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="36" VerticalContentAlignment="Center"
                     ToolTip="Describe the task for Jarvis to plan and verify." />
        </DockPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Task">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Task.TaskId, StringFormat=Task: {0}}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Task.FinalState, StringFormat=State: {0}}" />
                        <TextBlock Text="{Binding Task.FinalMessage, StringFormat=Result: {0}}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding Task.StatusMessage}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProgressMessage}" TextWrapping="Wrap" />
                        <ProgressBar Height="4" IsIndeterminate="{Binding IsRunning}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Task.VerificationStages}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,12,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Step" Binding="{Binding StepId}" />
                            <DataGridTextColumn Header="Stage" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Evidence">
                <StackPanel Margin="12">
                    <TextBlock Text="Independent verifier reasons" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding Task.Reasons}" />
                    <TextBlock Text="Executor diagnostics (untrusted; not verification evidence)" FontWeight="Bold" Margin="0,12,0,0" />
                    <ItemsControl ItemsSource="{Binding Task.ExecutorDiagnostics}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Verified search results">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Task.SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding StepId, StringFormat=Verified search step: {0}}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Paths.Count, StringFormat=Files found: {0}}" />
                                    <ItemsControl ItemsSource="{Binding Paths}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="History">
                <DataGrid Margin="12" ItemsSource="{Binding History.Events}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" />
                        <DataGridTextColumn Header="Event" Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="Task" Binding="{Binding TaskId}" />
                        <DataGridTextColumn Header="Step" Binding="{Binding StepId}" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Settings and doctor">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Settings.ModelName, StringFormat=Configured Ollama model: {0}}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Settings.PlannerDescription, StringFormat=Planner: {0}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="Allowed roots" Margin="0,12,0,4" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Settings.AllowedRoots}" />
                        <TextBlock Text="Doctor results" Margin="0,12,0,4" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding Settings.DoctorResults}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="MailTab" Header="Mail results">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProgressMessage}" TextWrapping="Wrap" />
                        <TextBlock Text="Try: get today's mail. Mail bodies are loaded and summarized only after you select one and choose Explain."
                                   Foreground="Gray" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" Margin="0,8,0,8" ItemsSource="{Binding MailResults}"
                              SelectedItem="{Binding SelectedMail, Mode=TwoWay}" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="2*" />
                            <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*" />
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2" Content="Explain selected mail" Width="180" Height="32"
                            HorizontalAlignment="Left" Click="ExplainMail_Click"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}" />
                    <ScrollViewer Grid.Row="3" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding MailDetail}">
                            <TextBlock Text="{Binding Subject}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding From, StringFormat=From: {0}}" />
                            <TextBlock Text="{Binding Date, StringFormat=Date: {0}}" />
                            <TextBlock Text="Summary (local Ollama model)" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" BorderThickness="0" Background="#FFF6F6F6" />
                            <TextBlock Text="Full mail" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBox Text="{Binding Body, Mode=OneWay}" IsReadOnly="True"
                                     TextWrapping="Wrap" MinHeight="100" MaxHeight="300"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Google account">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Google account" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding GoogleAccount.Account.Email, StringFormat=Account: {0}}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding GoogleAccount.StatusMessage}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding GoogleAccount.NetworkAccessEnabled,
                                                  StringFormat=Exact Google HTTPS policy enabled: {0}}"
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Connect Google" Width="140" Height="32"
                                    Click="ConnectGoogle_Click"
                                    IsEnabled="{Binding GoogleAccount.CanConnect}" />
                            <Button Content="Disconnect" Width="110" Height="32" Margin="8,0,0,0"
                                    Click="DisconnectGoogle_Click"
                                    IsEnabled="{Binding GoogleAccount.CanDisconnect}" />
                        </StackPanel>
                        <TextBlock Text="Enabled Google services (restart Jarvis after changes)"
                                   FontWeight="Bold" Margin="0,18,0,6" />
                        <CheckBox Content="Calendar (read-only)" IsChecked="{Binding GoogleAccount.CalendarEnabled}"
                                  IsEnabled="{Binding GoogleAccount.IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        <CheckBox Content="Gmail (read-only)" IsChecked="{Binding GoogleAccount.GmailEnabled}"
                                  IsEnabled="{Binding GoogleAccount.IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        <TextBlock Text="Drive and Meet are disabled in this milestone."
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Calendar &amp; Gmail">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button Content="Refresh" Width="90" Height="30"
                                    DockPanel.Dock="Right" Click="RefreshCalendar_Click"
                                    IsEnabled="{Binding GoogleWorkspace.CanLoadCalendar}" />
                            <TextBlock Text="Upcoming Calendar events" FontSize="17"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding GoogleWorkspace.CalendarStatus}"
                                   TextWrapping="Wrap" Margin="0,6,0,8" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding GoogleWorkspace.CalendarEvents}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Event" Binding="{Binding Summary}" Width="*" />
                                <DataGridTextColumn Header="Starts" Binding="{Binding Start}" Width="*" />
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button Content="Refresh" Width="90" Height="30"
                                    DockPanel.Dock="Right" Click="RefreshGmail_Click"
                                    IsEnabled="{Binding GoogleWorkspace.CanLoadGmail}" />
                            <TextBlock Text="Recent Gmail inbox" FontSize="17"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding GoogleWorkspace.GmailStatus}"
                                   TextWrapping="Wrap" Margin="0,6,0,8" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding GoogleWorkspace.GmailMessages}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                                <DataGridTextColumn Header="Snippet" Binding="{Binding Snippet}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
